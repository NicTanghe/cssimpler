#usda 1.0
(
    defaultPrim = "Studio"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Studio"
{
    def Mesh "Receiver"
    {
        uniform token subdivisionScheme = "none"
        custom bool cssimpler:castsShadow = false
        point3f[] points = [(-1, 0.2, -0.65), (1, 0.2, -0.65), (1, 0.2, 0.65), (-1, 0.2, 0.65)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        texCoord2f[] primvars:st = [(0, 1), (1, 0), (0, 0), (1, 1)] (
            interpolation = "faceVarying"
        )
        int[] primvars:st:indices = [2, 0, 3, 1]
    }

    def Mesh "Caster"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(-0.25, 0.8, -0.3), (0.35, 0.8, -0.3), (0.35, 0.8, 0.3), (-0.25, 0.8, 0.3),
                            (-0.25, 1.1, -0.3), (0.35, 1.1, -0.3), (0.35, 1.1, 0.3), (-0.25, 1.1, 0.3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 3, 2, 6, 7, 0, 3, 7, 4, 1, 5, 6, 2]
    }
}
